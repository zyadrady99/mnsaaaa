# Local server values are generated by npm run local:setup.
# Never prefix these credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://dorosna_server:REPLACE_LOCAL_PASSWORD@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVER_KEY=REPLACE_LOCAL_SERVER_KEY
APP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
APP_ORIGIN=http://127.0.0.1:3000
DOROSNA_LOCAL_ONLY=1

# Online setup replaces the local values above and sets DOROSNA_LOCAL_ONLY=0.
# Copy the Transaction pooler URL from Supabase Connect, using the app's own role.
# Keep SSL parameters out of DATABASE_URL; verified TLS is enabled automatically.
# DATABASE_POOL_MAX=1
# DATABASE_SSL_CA=optional PEM certificate (literal newlines or escaped \n)
# SUPABASE_IMAGE_BUCKET=private bucket configured during online setup
# APP_JOB_SECRET=independent random secret, 64 hexadecimal characters
