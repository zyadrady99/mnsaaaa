{
  "name": "dorosna",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "local:setup": "node scripts/setup-local.mjs",
    "local:seed": "node scripts/seed-local.mjs",
    "local:admin": "node scripts/create-local-admin.mjs",
    "local:video": "node scripts/create-local-video.mjs",
    "local:demo": "node scripts/prepare-local-demo.mjs",
    "test:local": "node scripts/verify-local-auth.mjs && node scripts/verify-local-codes.mjs && node scripts/verify-local-learning.mjs && node scripts/verify-local-recovery.mjs && node scripts/verify-local-admin.mjs",
    "lint": "eslint src next.config.ts",
    "format": "prettier --write src public/images next.config.ts eslint.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "~5.9.3"
  }
}
