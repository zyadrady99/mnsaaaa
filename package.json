{
  "name": "dorosna",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-local.ps1 -WithDataApi -ServerOnlyAuth -ProductMode",
    "local:setup": "node scripts/local/setup-local.mjs",
    "local:seed": "node scripts/local/seed-local.mjs",
    "local:admin": "node scripts/local/create-local-admin.mjs",
    "local:video": "node scripts/local/create-local-video.mjs",
    "local:demo": "node scripts/local/prepare-local-demo.mjs",
    "test:local": "node scripts/verification/verify-local-auth.mjs && node scripts/verification/verify-local-codes.mjs && node scripts/verification/verify-local-learning.mjs && node scripts/verification/verify-local-recovery.mjs && node scripts/verification/verify-local-admin.mjs",
    "test:features": "node scripts/verification/verify-local-media.mjs && node scripts/verification/verify-local-deletion.mjs && node scripts/verification/verify-local-standalone.mjs",
    "test:config": "node --experimental-vm-modules scripts/verification/verify-cloud-config.mjs",
    "test:image-storage": "node --experimental-vm-modules scripts/verification/verify-image-storage.mjs",
    "test:deadline-job": "node --experimental-vm-modules scripts/verification/verify-deadline-job.mjs",
    "lint": "eslint src scripts next.config.ts eslint.config.mjs --max-warnings=0",
    "format": "prettier --write src scripts public/images next.config.ts eslint.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check src scripts public/images next.config.ts eslint.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "~5.9.3"
  }
}
